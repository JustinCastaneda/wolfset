{
  "expo": {
    "name": "WOLFSET",
    "slug": "wolfset",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wolfset",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#201a18",
    "android": {
      "package": "app.wolfset",
      "adaptiveIcon": {
        "backgroundColor": "#201a18",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "bundleIdentifier": "app.wolfset",
      "icon": "./assets/expo.icon"
    },
    "plugins": [
      "./plugins/withSharedDebugKeystore",
      "expo-router",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Geom",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Geom-Light.ttf",
                    "weight": 300
                  },
                  {
                    "path": "./assets/fonts/Geom-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Geom-Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Geom-SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Geom-Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/Geom-ExtraBold.ttf",
                    "weight": 800
                  },
                  {
                    "path": "./assets/fonts/Geom-Black.ttf",
                    "weight": 900
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/Geom-Light.ttf",
              "./assets/fonts/Geom-Regular.ttf",
              "./assets/fonts/Geom-Medium.ttf",
              "./assets/fonts/Geom-SemiBold.ttf",
              "./assets/fonts/Geom-Bold.ttf",
              "./assets/fonts/Geom-ExtraBold.ttf",
              "./assets/fonts/Geom-Black.ttf"
            ]
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#201a18",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
