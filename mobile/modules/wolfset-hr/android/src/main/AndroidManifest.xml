<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The rest timer: a health-type foreground service (the type Android reserves for
         fitness timers), which on Android 14+ also needs a runtime sensor permission —
         activity recognition is the lightest. Vibrate + notify when the rest is over. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <!-- The workout's foreground service: keeps the session alive in a pocket, boots
             JavaScript when the watch starts a workout with the app dead, and holds each
             rest while the screen is off (docs/rest-timer.md). -->
        <service
            android:name="app.wolfset.hr.WorkoutService"
            android:exported="false"
            android:foregroundServiceType="health" />

        <!-- Play services starts this on every watch message, whatever state the app is in —
             samples land while the phone is in a pocket — and on every change to the
             watch's queue of taps, which is how a Log tapped out of reach arrives once the
             two meet again. Paths must match docs/hr-protocol.md. -->
        <service
            android:name="app.wolfset.hr.HrListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/wolfset" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/wolfset/taps" />
            </intent-filter>
        </service>

        <!-- Dev only (debuggable builds; ignored otherwise): a watch tap over ADB, for an
             emulator with no watch. See HrListenerService.DebugWatchAction. -->
        <receiver
            android:name="app.wolfset.hr.HrListenerService$DebugWatchAction"
            android:exported="true">
            <intent-filter>
                <action android:name="app.wolfset.hr.WATCH_ACTION" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
