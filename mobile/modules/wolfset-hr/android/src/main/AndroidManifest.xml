<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Play services starts this on every watch message, whatever state the app is in —
             samples land while the phone is in a pocket. Path prefix must match
             docs/hr-protocol.md. -->
        <service
            android:name="app.wolfset.hr.HrListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/wolfset" />
            </intent-filter>
        </service>
    </application>
</manifest>
