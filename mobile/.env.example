# Copy to .env and fill in. .env is gitignored (root .gitignore: `.env`, `.env.*`).
#
# ── EXPO_PUBLIC_* is NOT secret ──────────────────────────────────────────────
# Expo inlines every EXPO_PUBLIC_* var into the JS bundle at build time. Anyone
# with the APK can read them. Only put values here that are safe to ship to a
# user's device.
#
# The Supabase anon key belongs in this category *by design* — it identifies the
# project, it is meant to be embedded in clients, and it grants nothing on its
# own. Row Level Security is what actually protects the data. An anon key with
# RLS off is a public database; an anon key with RLS on is fine in an APK.
#
# The service_role key is the opposite: it bypasses RLS entirely. It must never
# appear in this app, in EXPO_PUBLIC_*, in EAS build env, or in git. It belongs
# only in server-side contexts (Supabase Edge Functions, a backend you control).
#
# Not needed until Phase 6 — recorded now so setup isn't archaeology later.

EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
